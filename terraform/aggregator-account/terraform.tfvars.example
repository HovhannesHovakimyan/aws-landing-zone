# Spoke VPC
vpc_name         = "<SET_ME>"
vpc_cidr         = "<SET_ME>"
tgw_subnet_cidrs = ["<SET_ME>", "<SET_ME>"]
tgw_subnet_azs   = ["<SET_ME>", "<SET_ME>"]

# TGW attachment
attachment_name   = "<SET_ME>"
destination_cidrs = ["<SET_ME>", "<SET_ME>"]
